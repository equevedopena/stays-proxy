STAYS_DOMAIN=rcs.stays.net
STAYS_CLIENT_ID=tu_client_id
STAYS_CLIENT_SECRET=tu_client_secret
PORT=3000
# Clave para usar /auto/* y los endpoints que cambian precios (elige una larga y secreta)
ADMIN_TOKEN=
# Descuentos por hora: arranca apagado y en simulación
AUTO_ENABLED=false
AUTO_DRY_RUN=true
TICK_MINUTES=15
# Carpeta para guardar estado y registro (en Railway, montar un Volume aquí)
DATA_DIR=/data
